<#@ template debug="false" hostspecific="false" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Linq" #>
<#@ output extension=".g.cs" #>
<#@ parameter type="System.Boolean" name="ExtendedClasses" #>
<#
    // Configuration
    int minGenerics = ExtendedClasses ? 5 : 2;
    int maxGenerics = ExtendedClasses ? 16 : 4;
    
    var fluentTypes = new[]
    {
        new { ClassName = "FluentTableEntity", Discriminator = "$type" },
        new { ClassName = "FluentPartitionTableEntity", Discriminator = "PartitionKey" },
        new { ClassName = "FluentRowTableEntity", Discriminator = "RowKey" }
    };
#>
using System.Linq.Expressions;
using System.Runtime.CompilerServices;
using TableStorage.Fluent;
using TableStorage.Visitors;

#nullable enable

namespace TableStorage.Linq;

<# foreach (var fluentType in fluentTypes) { #>
<# for (int genericCount = minGenerics; genericCount <= maxGenerics; genericCount++) { 
    GenerateQueryHelper(fluentType.ClassName, fluentType.Discriminator, genericCount);
} #>

<# } #>
<#+
    private void GenerateQueryHelper(string className, string discriminator, int genericCount)
    {
        // Generate generic type parameters
        var typeParams = Enumerable.Range(1, genericCount)
            .Select(i => $"T{i}")
            .ToList();
        
        var typeParamList = string.Join(", ", typeParams);
        
        // Generate constraints
        var constraints = typeParams
            .Select(t => $"where {t} : class, IDictionary<string, object>, ITableEntity, new()")
            .ToList();
        
        var constraintList = string.Join("\n        ", constraints);
        
        // Determine the discriminator field for the filter
        string discriminatorField = discriminator == "$type" ? "x[$type]" : $"x.{discriminator}";
        
        // Generate CreateFilter method only if discriminator is "$type"
        string createFilterMethod = "";
        if (discriminator == "$type")
        {
            createFilterMethod = $@"
        private static Expression<Func<{className}<{typeParamList}>, bool>> CreateFilter()
        {{
            ParameterExpression parameter = Expression.Parameter(DollarTypeClass.Type, ""x"");
            Expression propertyAccess = Expression.Property(parameter, ""$type"");
            Expression equality = Expression.Equal(
                propertyAccess,
                Expression.Constant(typeof(T).Name)
            );
            return Expression.Lambda<Func<{className}<{typeParamList}>, bool>>(equality, Expression.Parameter(typeof({className}<{typeParamList}>)));
        }}
";
        }
        
        // Generate Find methods for each type
        var findMethods = new List<string>();
        if (className != "FluentTableEntity") // Skip for FluentTableEntity
        {
            for (int i = 0; i < genericCount; i++)
            {
                string ordinalName = GetOrdinalName(i + 1);
                string typeName = typeParams[i];
                string typeNameLiteral = $"typeof({typeName}).Name";
                
                if (className == "FluentRowTableEntity")
                {
                    // For FluentRowTableEntity: take partitionKey parameter, use typeNameLiteral as rowKey
                    findMethods.Add($@"
        public Task<{className}<{typeParamList}>?> Find{ordinalName}Async(string partitionKey, CancellationToken token = default)
        {{
            Expression<Func<{className}<{typeParamList}>, bool>> predicate = Helpers.CreateFindPredicate<{className}<{typeParamList}>>(partitionKey, {typeNameLiteral}, table.PartitionKeyProxy, table.RowKeyProxy);
            return table.Where(predicate).FirstOrDefaultAsync(token);
        }}

        public IFilteredTableQueryable<{className}<{typeParamList}>> Find{ordinalName}Async(params IReadOnlyList<string> partitionKeys)
        {{
            var keys = partitionKeys.Select(pk => (partitionKey: pk, rowKey: {typeNameLiteral})).ToList();
            Expression<Func<{className}<{typeParamList}>, bool>> predicate = Helpers.CreateFindPredicate<{className}<{typeParamList}>>(keys, table.PartitionKeyProxy, table.RowKeyProxy);
            return table.Where(predicate);
        }}");
                }
                else
                {
                    // For FluentPartitionTableEntity: use typeNameLiteral as partitionKey, take rowKey parameter
                    findMethods.Add($@"
        public Task<{className}<{typeParamList}>?> Find{ordinalName}Async(string rowKey, CancellationToken token = default)
        {{
            Expression<Func<{className}<{typeParamList}>, bool>> predicate = Helpers.CreateFindPredicate<{className}<{typeParamList}>>({typeNameLiteral}, rowKey, table.PartitionKeyProxy, table.RowKeyProxy);
            return table.Where(predicate).FirstOrDefaultAsync(token);
        }}

        public IFilteredTableQueryable<{className}<{typeParamList}>> Find{ordinalName}Async(params IReadOnlyList<string> rowKeys)
        {{
            var keys = rowKeys.Select(rk => (partitionKey: {typeNameLiteral}, rowKey: rk)).ToList();
            Expression<Func<{className}<{typeParamList}>, bool>> predicate = Helpers.CreateFindPredicate<{className}<{typeParamList}>>(keys, table.PartitionKeyProxy, table.RowKeyProxy);
            return table.Where(predicate);
        }}");
                }
            }
        }
        
        var findMethodList = string.Join("\n", findMethods);
        
        // Generate Where type methods
        var whereTypeMethods = new List<string>();
        for (int i = 0; i < genericCount; i++)
        {
            string ordinalName = GetOrdinalName(i + 1);
            string typeName = typeParams[i];
            
            whereTypeMethods.Add($"public IFilteredTableQueryable<{typeName}> Where{ordinalName}Type() => table.WhereTypeIs<{typeParamList}, {typeName}>();");
        }
        
        var whereTypeMethodList = string.Join("\n        ", whereTypeMethods);
        
        // Generate extension methods for each type (Where, SelectFields, ExistsIn, NotExistsIn)
        var extensionMethods = new List<string>();
        for (int i = 0; i < genericCount; i++)
        {
            string typeName = typeParams[i];
            
            extensionMethods.Add($@"public IFilteredTableQueryable<{typeName}> Where(Expression<Func<{typeName}, bool>> predicate) => table.Where{GetOrdinalName(i + 1)}Type().Where(predicate);
        public ISelectedTableQueryable<{typeName}> SelectFields<TResult>(Expression<Func<{typeName}, TResult>> selector) => table.Where{GetOrdinalName(i + 1)}Type().SelectFields(selector);
        public IFilteredTableQueryable<{typeName}> ExistsIn<TElement>(Expression<Func<{typeName}, TElement>> predicate, IEnumerable<TElement> elements) => table.Where{GetOrdinalName(i + 1)}Type().ExistsIn(predicate, elements);
        public IFilteredTableQueryable<{typeName}> NotExistsIn<TElement>(Expression<Func<{typeName}, TElement>> predicate, IEnumerable<TElement> elements) => table.Where{GetOrdinalName(i + 1)}Type().NotExistsIn(predicate, elements);");
        }
        
        var extensionMethodList = string.Join("\n        ", extensionMethods);
#>
public static class <#= className #><#= genericCount #>QueryHelper
{
    extension<<#= typeParamList #>>(TableSet<<#= className #><<#= typeParamList #>>> table)
        <#= constraintList #>
    {
        internal <#= className #>SetQueryHelper<T, <#= typeParamList #>> WhereTypeIs<T>() where T : class, IDictionary<string, object>, ITableEntity, new()
        {
            return new(TableSetQueryHelper.From(table));
        }
<#= findMethodList #>
        <#= whereTypeMethodList #>
        <#= extensionMethodList #>
    }

    internal sealed class <#= className #>SetQueryHelper<T, <#= typeParamList #>>(TableSetQueryHelper<<#= className #><<#= typeParamList #>>> helper) :
        IAsyncEnumerable<T>,
        ISelectedTableQueryable<T>,
        ITakenTableQueryable<T>,
        IFilteredTableQueryable<T>,
        ISelectedTakenTableQueryable<T>
        where T : class, IDictionary<string, object>, ITableEntity, new() // T is either T1..T<#= genericCount #>. We've already filtered by Type before this helper is created
        <#= constraintList #>
    {
        // We know that the PartitionKey is always the name of type T for FluentPartitionTableEntity, the RowKey for FluentRowTableEntity and the $type field for FluentTableEntity
        private readonly TableSetQueryHelper<<#= className #><<#= typeParamList #>>> _helper = helper.AddFilter(<#= discriminator == "$type" ? "CreateFilter()" : $"x => x.{discriminator} == typeof(T).Name" #>);
<#= createFilterMethod #>
        private static Expression<Func<<#= className #><<#= typeParamList #>>, TResult>> AlterExpression<TResult>(Expression<Func<T, TResult>> expression)
        {
            // Fake our input type to be T, regardless if it compiles or not.
            // For runtime compilation, the expression must be rewritten by using indexers instead of direct property access.
            // ( That's a TODO for later... )
            ParameterExpression parameter = Expression.Parameter(typeof(<#= className #><<#= typeParamList #>>));
            return Expression.Lambda<Func<<#= className #><<#= typeParamList #>>, TResult>>(expression.Body, parameter);
        }

        public async IAsyncEnumerator<T> GetAsyncEnumerator(CancellationToken cancellationToken)
        {
            await foreach (<#= className #><<#= typeParamList #>> entity in _helper.WithCancellation(cancellationToken))
            {
                yield return Unsafe.As<T>(entity.GetRawValue());
            }
        }

        public Task<int> BatchDeleteAsync(CancellationToken token = default) => _helper.BatchDeleteAsync(token);

        public Task<int> BatchDeleteTransactionAsync(CancellationToken token = default) => _helper.BatchDeleteTransactionAsync(token);

        public async Task<T> FirstAsync(CancellationToken token = default) => Unsafe.As<T>((await _helper.FirstAsync(token)).GetRawValue());

        public async Task<T?> FirstOrDefaultAsync(CancellationToken token = default) => Unsafe.As<T>((await _helper.FirstOrDefaultAsync(token))?.GetRawValue());

        public async Task<T> SingleAsync(CancellationToken token = default) => Unsafe.As<T>((await _helper.SingleAsync(token)).GetRawValue());

        public async Task<T?> SingleOrDefaultAsync(CancellationToken token = default) => Unsafe.As<T>((await _helper.SingleOrDefaultAsync(token))?.GetRawValue());

        private void SelectFields<TResult>(Expression<Func<T, TResult>> selector)
        {
            SelectionVisitor visitor = new(_helper.Table.PartitionKeyProxy, _helper.Table.RowKeyProxy);
            visitor.Visit(selector);

            if (visitor.Members.Count is 0)
            {
                throw new NotSupportedException("Select expression is not supported");
            }
            else
            {
                visitor.Members.Add(<#= className #><<#= typeParamList #>>.Discriminator);
                _helper.SetFields(visitor.Members);
            }
        }

        ISelectedTableQueryable<T> IFilteredTableQueryable<T>.SelectFields<TResult>(Expression<Func<T, TResult>> selector)
        {
            SelectFields(selector);
            return this;
        }

        ISelectedTakenTableQueryable<T> ITakenTableQueryable<T>.SelectFields<TResult>(Expression<Func<T, TResult>> selector)
        {
            SelectFields(selector);
            return this;
        }

        ITakenTableQueryable<T> IFilteredTableQueryable<T>.Take(int amount)
        {
            _helper.SetAmount(amount);
            return this;
        }

        ISelectedTakenTableQueryable<T> ISelectedTableQueryable<T>.Take(int amount)
        {
            _helper.SetAmount(amount);
            return this;
        }

        IFilteredTableQueryable<T> IFilteredTableQueryable<T>.Where(Expression<Func<T, bool>> predicate)
        {
            _helper.AddFilter(AlterExpression(predicate));
            return this;
        }

        ISelectedTakenTableQueryable<T> ISelectedTakenTableQueryable<T>.Where(Expression<Func<T, bool>> predicate)
        {
            _helper.AddFilter(AlterExpression(predicate));
            return this;
        }

        ITakenTableQueryable<T> ITakenTableQueryable<T>.Where(Expression<Func<T, bool>> predicate)
        {
            _helper.AddFilter(AlterExpression(predicate));
            return this;
        }

        ISelectedTableQueryable<T> ISelectedTableQueryable<T>.Where(Expression<Func<T, bool>> predicate)
        {
            _helper.AddFilter(AlterExpression(predicate));
            return this;
        }

        ISelectedTakenTableQueryable<T> ISelectedTakenTableQueryable<T>.ExistsIn<TElement>(Expression<Func<T, TElement>> predicate, IEnumerable<TElement> elements)
        {
            _helper.AddExistsInFilter(AlterExpression(predicate), elements);
            return this;
        }

        IFilteredTableQueryable<T> IFilteredTableQueryable<T>.ExistsIn<TElement>(Expression<Func<T, TElement>> predicate, IEnumerable<TElement> elements)
        {
            _helper.AddExistsInFilter(AlterExpression(predicate), elements);
            return this;
        }

        ITakenTableQueryable<T> ITakenTableQueryable<T>.ExistsIn<TElement>(Expression<Func<T, TElement>> predicate, IEnumerable<TElement> elements)
        {
            _helper.AddExistsInFilter(AlterExpression(predicate), elements);
            return this;
        }

        ISelectedTableQueryable<T> ISelectedTableQueryable<T>.ExistsIn<TElement>(Expression<Func<T, TElement>> predicate, IEnumerable<TElement> elements)
        {
            _helper.AddExistsInFilter(AlterExpression(predicate), elements);
            return this;
        }

        ISelectedTakenTableQueryable<T> ISelectedTakenTableQueryable<T>.NotExistsIn<TElement>(Expression<Func<T, TElement>> predicate, IEnumerable<TElement> elements)
        {
            _helper.AddNotExistsInFilter(AlterExpression(predicate), elements);
            return this;
        }

        IFilteredTableQueryable<T> IFilteredTableQueryable<T>.NotExistsIn<TElement>(Expression<Func<T, TElement>> predicate, IEnumerable<TElement> elements)
        {
            _helper.AddNotExistsInFilter(AlterExpression(predicate), elements);
            return this;
        }

        ITakenTableQueryable<T> ITakenTableQueryable<T>.NotExistsIn<TElement>(Expression<Func<T, TElement>> predicate, IEnumerable<TElement> elements)
        {
            _helper.AddNotExistsInFilter(AlterExpression(predicate), elements);
            return this;
        }

        ISelectedTableQueryable<T> ISelectedTableQueryable<T>.NotExistsIn<TElement>(Expression<Func<T, TElement>> predicate, IEnumerable<TElement> elements)
        {
            _helper.AddNotExistsInFilter(AlterExpression(predicate), elements);
            return this;
        }
    }
}
<#+
    }

    private string GetOrdinalName(int number)
    {
        return number switch
        {
            1 => "First",
            2 => "Second",
            3 => "Third",
            4 => "Fourth",
            5 => "Fifth",
            6 => "Sixth",
            7 => "Seventh",
            8 => "Eighth",
            9 => "Ninth",
            10 => "Tenth",
            11 => "Eleventh",
            12 => "Twelfth",
            13 => "Thirteenth",
            14 => "Fourteenth",
            15 => "Fifteenth",
            16 => "Sixteenth",
            _ => throw new ArgumentOutOfRangeException(nameof(number))
        };
    }
#>
