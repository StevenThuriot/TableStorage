<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- 👇 We don't want to reference the source generator dll directly in consuming projects -->
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<IsPackable>false</IsPackable>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<VersionPrefix>$(MajorMinorVersion).$(BuildVersion)</VersionPrefix>
		<GeneratedVersionFile>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\GeneratedVersion.g.cs</GeneratedVersionFile>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="$(GeneratedVersionFile)" Visible="false" />
		<AdditionalFiles Include="AnalyzerReleases.*.md" />
	</ItemGroup>

	<Target Name="GenerateVersionSource" BeforeTargets="CoreCompile" Inputs="$(MSBuildProjectFullPath);$(MSBuildAllProjects)" Outputs="$(GeneratedVersionFile)">
		<ItemGroup>
			<_GeneratedVersionSource Include="// &lt;auto-generated /&gt;" />
			<_GeneratedVersionSource Include="namespace TableStorage.SourceGenerators" />
			<_GeneratedVersionSource Include="{" />
			<_GeneratedVersionSource Include="internal static partial class Header" />
			<_GeneratedVersionSource Include="{" />
			<_GeneratedVersionSource Include="    public const string Version = &quot;$(VersionPrefix)&quot;%3B" />
			<_GeneratedVersionSource Include="}" />
			<_GeneratedVersionSource Include="}" />
		</ItemGroup>
		<WriteLinesToFile File="$(GeneratedVersionFile)" Lines="@(_GeneratedVersionSource)" Overwrite="true" />
	</Target>

	<!-- This ensures the library will be packaged as a source generator when we use `dotnet pack` -->
	<ItemGroup>
		<None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>
</Project>
